diff --git a/lib/posix-tty/serial.c b/lib/posix-tty/serial.c
index 84334c4..5ce8360 100644
--- a/lib/posix-tty/serial.c
+++ b/lib/posix-tty/serial.c
@@ -90,7 +90,11 @@ static int init_tty_cons(struct uk_init_ctx *ictx __unused)
 	return 0;
 }
 
-uk_rootfs_initcall_prio(init_tty_cons, 0x0, UK_PRIO_AFTER(UK_FS_PRIO_FSAVAIL));
+/* Workaround: macro chain UK_PRIO_AFTER(UK_FS_PRIO_FSAVAIL) doesn't fully
+ * expand to a number before stringification in __section(), producing a
+ * section name that the linker doesn't merge into .uk_inittab. Use a
+ * direct numeric priority (3 = AFTER(2 = FSAVAIL)). */
+uk_rootfs_initcall_prio(init_tty_cons, 0x0, 3);
 #else /* !CONFIG_LIBUKFS_DEVFS */
 static int init_tty_cons(struct uk_init_ctx *ictx __unused)
 {
@@ -168,5 +172,6 @@ setup_tty_globals:
 	return 0;
 }
 
-uk_rootfs_initcall_prio(init_tty_cons, 0x0, UK_FS_PRIO_FSAVAIL);
+/* See workaround note above. UK_FS_PRIO_FSAVAIL would be priority 2. */
+uk_rootfs_initcall_prio(init_tty_cons, 0x0, 2);
 #endif /* !CONFIG_LIBUKFS_DEVFS */
diff --git a/lib/posix-tty/tty.c b/lib/posix-tty/tty.c
index e382db3..599a9b0 100644
--- a/lib/posix-tty/tty.c
+++ b/lib/posix-tty/tty.c
@@ -145,12 +145,16 @@ static int init_posix_tty(struct uk_init_ctx *ictx __unused)
 }
 
 #if CONFIG_LIBPOSIX_TTY_SERIAL
-/* Must come after the handler in serial.c */
-uk_rootfs_initcall_prio(init_posix_tty, 0x0,
-			UK_PRIO_AFTER(UK_PRIO_AFTER(UK_FS_PRIO_FSAVAIL)));
+/* Must come after the handler in serial.c.
+ * Workaround: the original priority macro chain
+ * UK_PRIO_AFTER(UK_PRIO_AFTER(UK_FS_PRIO_FSAVAIL)) doesn't fully expand
+ * to a numeric token before stringification in __section(), causing the
+ * resulting section name to not be merged into the .uk_inittab block.
+ * Use a direct numeric priority that satisfies the same ordering. */
+uk_rootfs_initcall_prio(init_posix_tty, 0x0, 4);
 #else /* !CONFIG_LIBPOSIX_TTY_SERIAL */
 #if CONFIG_LIBPOSIX_TTY_DEVFS
-uk_rootfs_initcall_prio(init_posix_tty, 0x0, UK_FS_PRIO_FSAVAIL);
+uk_rootfs_initcall_prio(init_posix_tty, 0x0, 2);
 #else /* !CONFIG_LIBPOSIX_TTY_DEVFS */
 uk_rootfs_initcall(init_posix_tty, 0x0);
 #endif /* !CONFIG_LIBPOSIX_TTY_DEVFS */
