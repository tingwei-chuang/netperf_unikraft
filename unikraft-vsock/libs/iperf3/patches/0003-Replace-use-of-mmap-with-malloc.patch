From c1a417f82fa3e0cb7a47bbd9563d8b9c11e59196 Mon Sep 17 00:00:00 2001
From: pooiscoding <pooisworking@gmail.com>
Date: Fri, 19 Sep 2025 20:35:55 +0800
Subject: [PATCH 1/2] Replace-use-of-mmap-with-malloc

---
 src/iperf_api.c | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/iperf_api.c b/src/iperf_api.c
index aeec91d..82eda4c 100644
--- a/src/iperf_api.c
+++ b/src/iperf_api.c
@@ -4577,7 +4577,7 @@ iperf_free_stream(struct iperf_stream *sp)
     struct iperf_interval_results *irp, *nirp;
 
     /* XXX: need to free interval list too! */
-    munmap(sp->buffer, sp->test->settings->blksize);
+    free(sp->buffer);
     close(sp->buffer_fd);
     if (sp->diskfile_fd >= 0)
 	close(sp->diskfile_fd);
@@ -4661,8 +4661,10 @@ iperf_new_stream(struct iperf_test *test, int s, int sender)
         free(sp);
         return NULL;
     }
-    sp->buffer = (char *) mmap(NULL, test->settings->blksize, PROT_READ|PROT_WRITE, MAP_PRIVATE, sp->buffer_fd, 0);
-    if (sp->buffer == MAP_FAILED) {
+
+#warning "WARNING: mmap has been replaced with malloc since mmap is not stable in Unikraft (see lib-iperf3/patches)."
+    sp->buffer = (char *) malloc(test->settings->blksize);
+    if (!sp->buffer) {
         i_errno = IECREATESTREAM;
         free(sp->result);
         free(sp);
@@ -4680,7 +4682,7 @@ iperf_new_stream(struct iperf_test *test, int s, int sender)
 	sp->diskfile_fd = open(test->diskfile_name, sender ? O_RDONLY : (O_WRONLY|O_CREAT|O_TRUNC), S_IRUSR|S_IWUSR);
 	if (sp->diskfile_fd == -1) {
 	    i_errno = IEFILE;
-            munmap(sp->buffer, sp->test->settings->blksize);
+            free(sp->buffer);
             free(sp->result);
             free(sp);
 	    return NULL;
@@ -4700,7 +4702,7 @@ iperf_new_stream(struct iperf_test *test, int s, int sender)
 
     if ((ret < 0) || (iperf_init_stream(sp, test) < 0)) {
         close(sp->buffer_fd);
-        munmap(sp->buffer, sp->test->settings->blksize);
+        free(sp->buffer);
         free(sp->result);
         free(sp);
         return NULL;
-- 
